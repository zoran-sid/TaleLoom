  "scenes": [
    {
      "id": "lobby",
      "title": "海鸥旅馆·大堂",
      "text": "一九三一年，雾港。午夜的雾把煤气灯压成一团昏黄。\n陈掌柜被发现倒在账房里，警署的人要到天亮才能上岛。旅馆里只剩三个人：账房先生周文、女招待阿芸，和昨天才住进来的外地商人顾先生。顾先生坐在大堂角落的藤椅上，一根接一根地抽烟。\n你是这里唯一的客人，也是唯一愿意查下去的人。",
      "choices": [
        {
          "id": "office",
          "text": "推开账房的门",
          "goto": "office"
        },
        {
          "id": "gu",
          "text": "先盘问角落里的顾先生",
          "goto": "gu_first"
        },
        {
          "id": "bluff",
          "text": "直接指着顾先生：人是你杀的吧？",
          "goto": "gu_bluff"
        }
      ]
    },
    {
      "id": "gu_first",
      "title": "盘问·顾先生",
      "text": "你在顾先生对面坐下。他把烟灰弹进茶碟，没抬头。\n“我一整晚都在房里看书，哪儿也没去。”\n他说话的时候，你注意到他的裤脚湿了一大截，鞋边还沾着灰白的泥。",
      "on_enter": [
        {
          "add_clue": "gu_story"
        }
      ],
      "choices": [
        {
          "id": "office",
          "text": "不再追问，去账房看现场",
          "goto": "office"
        }
      ]
    },
    {
      "id": "gu_bluff",
      "title": "逼问·顾先生",
      "text": "你走到藤椅前，指着顾先生：“人是你杀的吧？”\n顾先生愣了一下，随即冷笑：“证据呢？”他把烟按灭在茶碟里，“在警署的人来之前，我一个字也不会再跟你说。”",
      "on_enter": [
