{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TaleLoom：启动游戏",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "TaleLoom：命令行游玩",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["play"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "TaleLoom：校验全部剧本",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["validate"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
