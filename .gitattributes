# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
.gitignore text eol=lf
.node-version text eol=lf

# Binary files
*.mp3 binary
*.mp4 binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
